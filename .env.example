# Copy this file to .env (or .env.local) and fill in.
# Both are gitignored.

# Server-side: used by api/chat.js to call Gemini.
# In production on Vercel, set this in the project's Environment Variables.
GEMINI_API_KEY=AIzaSy-your-key-here

# Client-side: absolute URL of the deployed API.
# REQUIRED for the native (Capacitor) build — /api/chat doesn't resolve from
# the WebView's local origin, so the APK must target your hosted backend.
# Leave EMPTY for the web build (web client uses the relative /api/chat path).
# Example: VITE_API_BASE_URL=https://thebestbuys.vercel.app
VITE_API_BASE_URL=https://thebestbuy.vercel.app

# Client-side: Google OAuth client ID used for "Se connecter avec Google".
# Create one in Google Cloud Console > APIs & Services > Credentials >
# "OAuth 2.0 Client IDs" of type "Web application". Add your deployed origin
# (e.g. https://thebestbuy.vercel.app) and http://localhost:5173 to the list
# of "Authorized JavaScript origins". Leave empty to disable Google sign-in.
# Example: VITE_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=808621430579-p65a1aiodjssefpr8f81fbo1kj77tm84.apps.googleusercontent.com

# Client-side: Supabase project (cross-device sync of selections & history).
# Optional — leave EMPTY to run on localStorage only (no cloud sync).
# Get these from Supabase > Project Settings > API.
#  - URL  = "Project URL"
#  - KEY  = the "Publishable key" (sb_publishable_...). On newer projects this
#           replaces the old "anon public" key — use it here. NEVER use the
#           "Secret key" (sb_secret_...) in the front-end.
# This client key is public by design; Row Level Security + the user's Google
# session protect each user's data. See SUPABASE_SETUP.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Server-side: Amazon Creators API (replaces the WAF-blocked HTML scraping).
# Generate the credentials in Associates Central > Tools > Creators API
# ("Ajouter des identifiants"). In production set these in Vercel's Environment
# Variables. If CLIENT_ID/SECRET are empty, verification is skipped and the UI
# falls back to estimated price ranges (no regression).
AMAZON_CREATORS_CLIENT_ID=your-credential-id
AMAZON_CREATORS_CLIENT_SECRET=your-credential-secret
AMAZON_PARTNER_TAG=oraklia123-21
AMAZON_MARKETPLACE=www.amazon.fr
# Advanced / only if API calls fail (check _debug.amazon_error). Defaults shown.
# AMAZON_CREATORS_TOKEN_URL=https://api.amazon.com/auth/o2/token
# AMAZON_CREATORS_SCOPE=creatorsapi/default
# AMAZON_CREATORS_API_BASE=https://creatorsapi.amazon/catalog/v1
